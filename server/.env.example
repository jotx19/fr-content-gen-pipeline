OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
TEF_LLM_MODEL=google/gemini-2.5-flash
# Legacy fallback for both modules if the specific vars below are unset
TEF_LLM_MAX_TOKENS=1200
# Reading MCQ generation (placement + practice) — needs more tokens for JSON batches
TEF_READING_LLM_MAX_TOKENS=1200
# Writing evaluation / optional LLM prompts — shorter JSON
TEF_WRITING_LLM_MAX_TOKENS=800
# Skip LLM for reading placement + practice — use built-in MCQ templates (recommended on low credits)
# TEF_READING_USE_TEMPLATES=true
# Min ms between duplicate prefetch requests per user (default 30000)
# TEF_PREFETCH_COOLDOWN_MS=30000
# Skip LLM for B1+ writing prompts — use built-in Section A/B templates (recommended on low credits)
# TEF_WRITING_USE_TEMPLATES=true
# Static task-matched examples (default). Set true to use OpenRouter for examples.
# TEF_WRITING_USE_LLM_EXAMPLES=true
TEF_PRACTICE_COUNT=3
TEF_PLACEMENT_COUNT=5
TEF_PERSONA=
APP_NAME=TEF Canada Coach
TEF_USE_EVALUATOR=false
TEF_USE_WEBSEARCH=true
SERPER_API_KEY=
MONGODB_URI=
QDRANT_URL=
QDRANT_API_KEY=
APP_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000
# Optional — allow multiple frontend origins (comma-separated). Example for localhost → Render API:
# CORS_ORIGINS=http://localhost:3000,https://your-app.onrender.com
# SESSION_COOKIE_SAME_SITE=none
AUTH_SECRET=change-me-to-a-long-random-string
GOOGLE_CLIENT_ID=
# Optional — only needed for redirect OAuth flow, not the Google Sign-In button
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google
# DeepL Free API key (keys ending in :fx use api-free.deepl.com)
DEEPL_AUTH_KEY=
PORT=3001
# Stripe billing (recurring subscriptions)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Enable Customer portal: Stripe Dashboard → Settings → Billing → Customer portal
# Turn on: Invoice history, Cancel subscriptions, Update payment method
# Stripe recurring Price IDs (price_...) — create as Recurring in Dashboard
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# Display amounts shown in UI (USD). Falls back to numeric STRIPE_PRICE_* if not price IDs.
BILLING_PRICE_MONTHLY=12
BILLING_PRICE_YEARLY=79
BILLING_PRICE_CURRENCY=usd
# Pro access duration fallback for legacy one-time purchases (days)
BILLING_ACCESS_DAYS_MONTHLY=30
BILLING_ACCESS_DAYS_YEARLY=365
# Free tier daily limits
FREEMIUM_READING_PER_DAY=1
FREEMIUM_WRITING_PER_DAY=1
# Free tier account limits
FREEMIUM_NOTES_MAX=2
FREEMIUM_TRANSLATIONS_MAX=500
# Security — comma-separated blocked IPs, rate limits
# BLOCKED_IPS=1.2.3.4,5.6.7.8
# SECURITY_GLOBAL_RATE_LIMIT=120
# SECURITY_AUTH_RATE_LIMIT=15
# SECURITY_AUTH_WINDOW_MS=900000
# SECURITY_LOGIN_BLOCK_THRESHOLD=20
# SECURITY_LOGIN_BLOCK_MS=86400000
